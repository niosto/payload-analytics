# Force LF line endings for all text files on all platforms
* text=auto eol=lf

# Explicit overrides for common file types
*.sh      text eol=lf
*.bash    text eol=lf
*.json    text eol=lf
*.yml     text eol=lf
*.yaml    text eol=lf
*.md      text eol=lf
*.js      text eol=lf
*.ts      text eol=lf
*.env     text eol=lf

# Binary files — never convert
*.png     binary
*.jpg     binary
*.jpeg    binary
*.gif     binary
*.ico     binary
*.zip     binary
*.gz      binary
*.tar     binary
*.pbix    binary
