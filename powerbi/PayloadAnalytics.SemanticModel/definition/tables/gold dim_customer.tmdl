table 'gold dim_customer'
	lineageTag: dd6a4729-ff58-4a22-b723-8a7472292873

	measure 'Mobile App Adoption Rate' =
			
			DIVIDE (
			    CALCULATE (
			        COUNTROWS ( 'gold dim_customer' ),
			        'gold dim_customer'[mobile_app_registered] = TRUE ()
			    ),
			    COUNTROWS ( 'gold dim_customer' ),
			    0
			)
		lineageTag: 214a16d6-5a64-4a9f-ad6e-a4c729318051

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'App Adopters Rate' =
			
			DIVIDE(
			    COUNTROWS(FILTER('gold dim_customer', 'gold dim_customer'[mobile_app_registered] = TRUE())),
			    COUNTROWS('gold dim_customer')
			)
		lineageTag: 938bcb79-b61f-49ef-99bd-a30aa6cbba45

		annotation PBI_FormatHint = {"isGeneralNumber":true}

