		dataType: boolean
		formatString: """TRUE"";""TRUE"";""FALSE"""
		lineageTag: 1da67356-4b3a-4b3e-8c74-243d1f8d1e7f
		summarizeBy: none
		sourceColumn: mobile_app_registered

		annotation SummarizationSetBy = Automatic

	column OrdenBanda = SWITCH([credit_score_band], "poor", 1, "fair", 2, "good", 3, "very_good", 4, "exceptional", 5)
		dataType: int64
		isHidden
		formatString: 0
		lineageTag: e269c455-2c51-44e9-b279-61cc48368200
		summarizeBy: none

	column Segmento = SWITCH([customer_segment], "premium", "Premium", "retail", "Retail", "sme", "SME", "private_banking", "Private banking", [customer_segment])
		dataType: string
		lineageTag: eaff6f4e-e745-4557-b5f6-980d43a65c51
		summarizeBy: none

	column Banda = SWITCH([credit_score_band], "poor", "Bajo", "fair", "Regular", "good", "Bueno", "very_good", "Muy bueno", "exceptional", "Excepcional", [credit_score_band])
		dataType: string
		lineageTag: a0dccd6c-35fd-4eca-8d61-a3c33017ae74
		summarizeBy: none
		sortByColumn: OrdenBanda

	partition 'gold dim_customer' = m
		mode: import
		source =
				let
				    Source = PostgreSQL.Database("localhost:5433", "payload_analytics"),
